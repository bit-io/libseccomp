[package]
-> name        => libseccomp
-> version     => 0.1.0
-> description => Native, pure-H# seccomp-bpf sandboxing (no libseccomp.so, no shims)
-> authors     => ["Bit Developers"]
-> license     => MIT
-> lang        => h#

[layout]
-> src => src

[build]
-> link => static

[lib]
-> output => hlib

[default-build]
-> profile => release

[dependencies]

[system-dependencies]
-> libc => *
