pub const CMP_EQ:        int = 0
pub const CMP_NE:        int = 1
pub const CMP_LT:        int = 2
pub const CMP_LE:        int = 3
pub const CMP_GT:        int = 4
pub const CMP_GE:        int = 5
pub const CMP_MASKED_EQ: int = 6

;; One argument condition: "seccomp_data.args[arg_idx] <op> value"
;; (`mask` is only meaningful for `CMP_MASKED_EQ`: `(args[idx] & mask)
;; == value`).
pub struct ArgCond is
    pub arg_idx: int
    pub op:      int
    pub value:   int
    pub mask:    int
end

pub fn eq(arg_idx: int, value: int) -> ArgCond is
    return ArgCond { arg_idx: arg_idx, op: CMP_EQ, value: value, mask: 0 }
end
pub fn ne(arg_idx: int, value: int) -> ArgCond is
    return ArgCond { arg_idx: arg_idx, op: CMP_NE, value: value, mask: 0 }
end
pub fn lt(arg_idx: int, value: int) -> ArgCond is
    return ArgCond { arg_idx: arg_idx, op: CMP_LT, value: value, mask: 0 }
end
pub fn le(arg_idx: int, value: int) -> ArgCond is
    return ArgCond { arg_idx: arg_idx, op: CMP_LE, value: value, mask: 0 }
end
pub fn gt(arg_idx: int, value: int) -> ArgCond is
    return ArgCond { arg_idx: arg_idx, op: CMP_GT, value: value, mask: 0 }
end
pub fn ge(arg_idx: int, value: int) -> ArgCond is
    return ArgCond { arg_idx: arg_idx, op: CMP_GE, value: value, mask: 0 }
end
pub fn masked_eq(arg_idx: int, mask: int, value: int) -> ArgCond is
    return ArgCond { arg_idx: arg_idx, op: CMP_MASKED_EQ, value: value, mask: mask }
end

;; A rule that also gates on argument values, all ANDed together —
;; matches iff the syscall number matches AND every condition holds.
;; A `CondRule` with an empty `conditions` list is exactly equivalent
;; to a plain `Rule`.
pub struct CondRule is
    pub nr:         int
    pub action:     int
    pub conditions: [ArgCond]
end

pub fn cond_rule(nr: int, action: int, conditions: [ArgCond]) -> CondRule is
    return CondRule { nr: nr, action: action, conditions: conditions }
end

;; Convenience: lift a plain `Rule` (rules.h#) into a `CondRule` with no
;; conditions, for mixing into a `[CondRule]` list alongside real
;; argument-gated rules.
pub fn rule_to_cond(r: rules::Rule) -> CondRule is
    return CondRule { nr: r.nr, action: r.action, conditions: [] }
end

;; byte offsets of `seccomp_data.args[idx]`'s two 32-bit halves — see
;; `struct seccomp_data` in bpf.h#'s header comment. Little-endian: the
;; low word sits at the lower address.
fn arg_off_lo(idx: int) -> int is
    return 16 + idx * 8
end
fn arg_off_hi(idx: int) -> int is
    return 16 + idx * 8 + 4
end

;; Emit the unpacked instructions for one `ArgCond`, following ir.h#'s
;; convention: falling through the end of the returned block means the
;; condition held; taking the jump means it failed.
fn emit_cond(c: ArgCond) -> [ir::Instr] is
    let mut out: [ir::Instr] = []
    if c.op == CMP_EQ is
        ;; full 64-bit equality: high word, then low word, both must match.
        out.push(ir::plain(OP_LD_W_ABS, arg_off_hi(c.arg_idx)))
        out.push(ir::cond(OP_JEQ_K, (c.value >> 32) & 0xFFFFFFFF))
        out.push(ir::plain(OP_LD_W_ABS, arg_off_lo(c.arg_idx)))
        out.push(ir::cond(OP_JEQ_K, c.value & 0xFFFFFFFF))
        return out
    end
    if c.op == CMP_NE is
        out.push(ir::plain(OP_LD_W_ABS, arg_off_lo(c.arg_idx)))
        out.push(ir::cond_inv(OP_JEQ_K, c.value & 0xFFFFFFFF))
        return out
    end
    if c.op == CMP_GT is
        out.push(ir::plain(OP_LD_W_ABS, arg_off_lo(c.arg_idx)))
        out.push(ir::cond(OP_JGT_K, c.value & 0xFFFFFFFF))
        return out
    end
    if c.op == CMP_GE is
        out.push(ir::plain(OP_LD_W_ABS, arg_off_lo(c.arg_idx)))
        out.push(ir::cond(OP_JGE_K, c.value & 0xFFFFFFFF))
        return out
    end
    if c.op == CMP_LT is
        ;; A < k  <=>  NOT(A >= k)
        out.push(ir::plain(OP_LD_W_ABS, arg_off_lo(c.arg_idx)))
        out.push(ir::cond_inv(OP_JGE_K, c.value & 0xFFFFFFFF))
        return out
    end
    if c.op == CMP_LE is
        ;; A <= k  <=>  NOT(A > k)
        out.push(ir::plain(OP_LD_W_ABS, arg_off_lo(c.arg_idx)))
        out.push(ir::cond_inv(OP_JGT_K, c.value & 0xFFFFFFFF))
        return out
    end
    ;; CMP_MASKED_EQ: (A & mask) == value
    out.push(ir::plain(OP_LD_W_ABS, arg_off_lo(c.arg_idx)))
    out.push(ir::plain(OP_ALU_AND_K, c.mask & 0xFFFFFFFF))
    out.push(ir::cond(OP_JEQ_K, c.value & 0xFFFFFFFF))
    return out
end

;; Build and pack one `CondRule`'s complete, self-contained instruction
;; block (nr check + every condition + the final RET), with every
;; internal jump patched relative to *this block's own* length — so the
;; packed result can just be concatenated after any other rule's block
;; with no further adjustment.
pub fn build_cond_rule_block(r: CondRule) -> [int] is
    let mut blk: [ir::Instr] = []
    blk.push(ir::plain(OP_LD_W_ABS, OFF_NR))
    blk.push(ir::cond(OP_JEQ_K, r.nr))
    let mut ci: int = 0
    while ci < r.conditions.len() is
        let parts: [ir::Instr] = emit_cond(r.conditions[ci])
        let mut cj: int = 0
        while cj < parts.len() is
            blk.push(parts[cj])
            cj += 1
        end
        ci += 1
    end
    blk.push(ir::fixed(OP_RET_K, 0, 0, r.action))
    return ir::patch_and_pack(blk)
end

;; Same contract as `bpf::build_program`, but for `[CondRule]`.
pub fn build_program_cond(rules: [CondRule], default_action: int, arch: int) -> [int] is
    let mut prog: [int] = []
    prog.push(bpf::pack_instr(OP_LD_W_ABS, 0, 0, OFF_ARCH))
    prog.push(bpf::pack_instr(OP_JEQ_K,    1, 0, arch))
    prog.push(bpf::pack_instr(OP_RET_K,    0, 0, ACTION_KILL_PROCESS))
    let mut i: int = 0
    while i < rules.len() is
        let block: [int] = build_cond_rule_block(rules[i])
        let mut j: int = 0
        while j < block.len() is
            prog.push(block[j])
            j += 1
        end
        i += 1
    end
    prog.push(bpf::pack_instr(OP_RET_K, 0, 0, default_action))
    return prog
end
