;; ── syscall tables ────────────────────────────────────────────────────

#[test]
fn test_number_known_syscalls() is
    assert_eq(syscalls::number("read"), 0)
    assert_eq(syscalls::number("write"), 1)
    assert_eq(syscalls::number("exit_group"), 231)
    assert_eq(syscalls::number("openat"), 257)
    assert_eq(syscalls::number("clone3"), 435)
end

#[test]
fn test_number_unknown_is_negative_one() is
    assert_eq(syscalls::number("this_syscall_does_not_exist"), -1)
    assert_eq(syscalls::number(""), -1)
end

#[test]
fn test_number_aarch64_differs_from_x86_64() is
    ;; same syscall, genuinely different number per the unified generic
    ;; table aarch64 uses — this is the whole reason the two tables
    ;; can't be merged with a couple of per-arch overrides.
    assert_eq(syscalls_aarch64::number_aarch64("read"), 63)
    assert_eq(syscalls_aarch64::number_aarch64("write"), 64)
    assert_eq(syscalls_aarch64::number_aarch64("openat"), 56)
    assert_eq(syscalls_aarch64::number_aarch64("exit_group"), 94)
end

#[test]
fn test_number_for_arch_dispatches_correctly() is
    assert_eq(syscalls::number_for_arch("read", ARCH_X86_64), 0)
    assert_eq(syscalls::number_for_arch("read", ARCH_AARCH64), 63)
end

