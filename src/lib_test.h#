#[test]
fn test_allow_nr_appends_allow_rule() is
    let mut rules: [rules::Rule] = rules::new_rules()
    rules = rules::allow_nr(rules, 0)
    assert_eq(rules.len(), 1)
    assert_eq(rules[0].nr, 0)
    assert_eq(rules[0].action, ACTION_ALLOW)
end

#[test]
fn test_allow_unknown_name_is_skipped() is
    ;; A typo must never silently turn into "allow everything" — an
    ;; unresolved name (number() == -1) should add nothing at all.
    let mut rules: [rules::Rule] = rules::new_rules()
    rules = rules::allow(rules, "not_a_real_syscall")
    assert_eq(rules.len(), 0)
end

#[test]
fn test_deny_errno_nr_packs_action() is
    let mut rules: [rules::Rule] = rules::new_rules()
    rules = rules::deny_errno_nr(rules, 101, 1)   ;; ptrace -> EPERM
    assert_eq(rules.len(), 1)
    assert_eq(rules[0].nr, 101)
    assert_eq(rules[0].action, consts::action_errno(1))
end

#[test]
fn test_allow_arch_uses_correct_table() is
    let mut rules: [rules::Rule] = rules::new_rules()
    rules = rules::allow_arch(rules, "read", ARCH_AARCH64)
    assert_eq(rules[0].nr, 63)   ;; not 0 — that would be the x86_64 table leaking in
end

#[test]
fn test_allow_baseline_is_nonempty_and_all_resolved() is
    let mut rules: [rules::Rule] = rules::new_rules()
    rules = rules::allow_baseline(rules)
    assert_true(rules.len() > 20)
    let mut i: int = 0
    while i < rules.len() is
        assert_true(rules[i].nr >= 0)
        assert_eq(rules[i].action, ACTION_ALLOW)
        i += 1
    end
end

