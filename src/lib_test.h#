    let mut rules: [rules::Rule] = rules::new_rules()
    rules.push(rules::Rule { nr: 5, action: ACTION_ALLOW })
    rules.push(rules::Rule { nr: 5, action: ACTION_KILL_PROCESS })
    rules.push(rules::Rule { nr: 6, action: ACTION_ALLOW })
    let out: [rules::Rule] = rules::dedupe_rules(rules)
    assert_eq(out.len(), 2)
    assert_eq(out[0].nr, 5)
    assert_eq(out[0].action, ACTION_ALLOW)
    assert_eq(out[1].nr, 6)
end

;; ── BPF instruction packing ───────────────────────────────────────────

#[test]
fn test_pack_instr_matches_sock_filter_byte_layout() is
    ;; code=0x15, jt=0x01, jf=0x02, k=0x11223344 ->
    ;; bytes (LE): 15 00 | 01 | 02 | 44 33 22 11
    ;; as one little-endian 64-bit word: 0x1122334402010015
    ;; (k is kept below 0x80000000 here on purpose — a k with its top
    ;; bit set, like a real SECCOMP_RET_KILL_PROCESS's 0x80000000, packs
    ;; fine at *runtime*, but a source-code hex literal for the full
    ;; packed word would then exceed i64::MAX and the lexer would parse
    ;; it as 0. `install_arch` never has this problem since it only
    ;; ever runs `pack_instr` at runtime, never writes the packed
    ;; result out as a literal.)
    let packed: int = bpf::pack_instr(0x15, 0x01, 0x02, 0x11223344)
    assert_eq(packed, 0x1122334402010015)
end

#[test]
fn test_pack_instr_masks_oversized_fields() is
    let packed: int = bpf::pack_instr(0x1FFFF, 0x1FF, 0x1FF, 0)
    assert_eq(packed, bpf::pack_instr(0xFFFF, 0xFF, 0xFF, 0))
end

#[test]
fn test_build_program_length() is
    let mut rules: [rules::Rule] = rules::new_rules()
    rules = rules::allow_nr(rules, 0)
    rules = rules::allow_nr(rules, 1)
    let prog: [int] = bpf::build_program(rules, ACTION_KILL_PROCESS, ARCH_X86_64)
    assert_eq(prog.len(), 4 + 2 * rules.len() + 1)
end

#[test]
fn test_build_program_starts_with_arch_check() is
    let rules: [rules::Rule] = rules::new_rules()
    let prog: [int] = bpf::build_program(rules, ACTION_KILL_PROCESS, ARCH_X86_64)
    let expect0: int = bpf::pack_instr(OP_LD_W_ABS, 0, 0, OFF_ARCH)
    let expect1: int = bpf::pack_instr(OP_JEQ_K, 1, 0, ARCH_X86_64)
    assert_eq(prog[0], expect0)
    assert_eq(prog[1], expect1)
end

;; ── multi-arch ────────────────────────────────────────────────────────

#[test]
fn test_build_program_multi_arch_accepts_either_listed_arch() is
    let mut rules: [rules::Rule] = rules::new_rules()
    rules = rules::allow_nr(rules, 0)
    let mut arches: [int] = []
    arches.push(ARCH_X86_64)
    arches.push(ARCH_I386)
    let prog: [int] = bpf::build_program_multi_arch(rules, ACTION_KILL_PROCESS, arches)
    ;; 1 (load arch) + 2 (arch checks) + 1 (kill) + 1 (load nr) + 2 (rule) + 1 (default)
    assert_eq(prog.len(), 1 + 2 + 1 + 1 + 2 + 1)
end

;; ── binary-search dispatch ────────────────────────────────────────────

#[test]
fn test_sort_rules_by_nr_sorts_ascending() is
    let mut rules: [rules::Rule] = rules::new_rules()
    rules.push(rules::Rule { nr: 50, action: ACTION_ALLOW })
    rules.push(rules::Rule { nr: 10, action: ACTION_ALLOW })
    rules.push(rules::Rule { nr: 30, action: ACTION_ALLOW })
    let sorted: [rules::Rule] = bpf::sort_rules_by_nr(rules)
    assert_eq(sorted[0].nr, 10)
    assert_eq(sorted[1].nr, 30)
    assert_eq(sorted[2].nr, 50)
end

#[test]
fn test_build_program_bsearch_well_formed() is
    ;; Not a byte-for-byte comparison against the linear scheme (the
    ;; encodings are genuinely different), just a sanity check that it
    ;; produces a well-formed, correctly-sized program for a handful of
    ;; rules: 4 fixed (arch load/check/kill, nr load) + 3 branch nodes
    ;; (for 4 leaves) * 2 + 4 leaves * 2.
    let mut rules: [rules::Rule] = rules::new_rules()
    rules = rules::allow_nr(rules, 0)
    rules = rules::allow_nr(rules, 1)
    rules = rules::allow_nr(rules, 2)
    rules = rules::allow_nr(rules, 3)
    let prog: [int] = bpf::build_program_bsearch(rules, ACTION_KILL_PROCESS, ARCH_X86_64)
    assert_eq(prog.len(), 4 + 3 * 2 + 4 * 2)
end

;; ── argument comparators ──────────────────────────────────────────────

#[test]
fn test_rule_to_cond_preserves_nr_and_action() is
    let r: rules::Rule = rules::Rule { nr: 42, action: ACTION_ALLOW }
    let c: comparators::CondRule = comparators::rule_to_cond(r)
    assert_eq(c.nr, 42)
    assert_eq(c.action, ACTION_ALLOW)
    assert_eq(c.conditions.len(), 0)
end

#[test]
fn test_cond_rule_block_no_conditions_is_three_instructions() is
    ;; [load nr, jeq nr, ret] = 3 instructions when there are no
    ;; conditions at all.
    let r: comparators::CondRule = comparators::cond_rule(0, ACTION_ALLOW, [])
    let block: [int] = comparators::build_cond_rule_block(r)
    assert_eq(block.len(), 3)
end

#[test]
fn test_cond_rule_block_eq_condition_adds_four_instructions() is
    ;; base 3 (load nr, jeq nr, ret) + eq's 4 (load hi, jeq hi, load lo, jeq lo)
    let conds: [comparators::ArgCond] = [comparators::eq(0, 5)]
    let r: comparators::CondRule = comparators::cond_rule(0, ACTION_ALLOW, conds)
    let block: [int] = comparators::build_cond_rule_block(r)
    assert_eq(block.len(), 3 + 4)
end

#[test]
fn test_cond_rule_block_single_word_comparator_adds_two_instructions() is
    ;; gt/ge/lt/le/ne all lower to "load lo + one conditional jump" = 2
    let conds: [comparators::ArgCond] = [comparators::gt(1, 100)]
    let r: comparators::CondRule = comparators::cond_rule(59, ACTION_ALLOW, conds)
    let block: [int] = comparators::build_cond_rule_block(r)
    assert_eq(block.len(), 3 + 2)
end

#[test]
fn test_cond_rule_block_masked_eq_adds_three_instructions() is
    let conds: [comparators::ArgCond] = [comparators::masked_eq(2, 0xFF, 1)]
    let r: comparators::CondRule = comparators::cond_rule(0, ACTION_ALLOW, conds)
    let block: [int] = comparators::build_cond_rule_block(r)
    assert_eq(block.len(), 3 + 3)
end

#[test]
fn test_build_program_cond_wraps_with_arch_check_and_default() is
    let conds: [comparators::ArgCond] = [comparators::eq(0, 5)]
    let r: comparators::CondRule = comparators::cond_rule(0, ACTION_ALLOW, conds)
    let mut rules: [comparators::CondRule] = []
    rules.push(r)
    let prog: [int] = comparators::build_program_cond(rules, ACTION_KILL_PROCESS, ARCH_X86_64)
    ;; 3 fixed (load arch, jeq arch, kill) + this rule's 7-instruction block + 1 default RET
    assert_eq(prog.len(), 3 + 7 + 1)
end

;; ── export / import ───────────────────────────────────────────────────

#[test]
fn test_export_import_hex_roundtrip() is
    let mut prog: [int] = []
    prog.push(1)
    prog.push(255)
    prog.push(65536)
    let hex: string = export::export_hex(prog)
    let back: [int] = export::import_hex(hex)
    assert_eq(back.len(), 3)
    assert_eq(back[0], 1)
    assert_eq(back[1], 255)
    assert_eq(back[2], 65536)
end

#[test]
fn test_export_pfc_produces_nonempty_output() is
    let mut rules: [rules::Rule] = rules::new_rules()
    rules = rules::allow_nr(rules, 0)
    let prog: [int] = bpf::build_program(rules, ACTION_KILL_PROCESS, ARCH_X86_64)
    let text: string = export::export_pfc(prog)
    assert_true(text.len() > 0)
end
